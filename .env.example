# Required: DeepSeek API key. Keep this file local after copying to .env.
DEEPSEEK_API_KEY=

# Optional settings
DEEPSEEK_BASE_URL=https://api.deepseek.com
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9000
GATEWAY_DB_PATH=storage/usage.db
GATEWAY_TIMEOUT_SECONDS=300
GATEWAY_DEFAULT_MODEL=deepseek-flash

# USD per million tokens. Update these when provider pricing changes.
GATEWAY_INPUT_CACHE_HIT_PER_M=0.006
GATEWAY_INPUT_CACHE_MISS_PER_M=0.3
GATEWAY_OUTPUT_PER_M=1.2

# --- V2: 多 provider ---
# 默认 provider（键名需存在于 GATEWAY_PROVIDERS 或内置的 deepseek）
GATEWAY_DEFAULT_PROVIDER=deepseek
# 额外 provider（JSON），键名为请求头 X-Gateway-Provider 可选的取值
# 例：GATEWAY_PROVIDERS={"kimi":{"base_url":"https://api.moonshot.cn/v1","api_key":"sk-xxx","default_model":"moonshot-v1-8k"}}
GATEWAY_PROVIDERS=

# --- V2: 预算（0 = 关闭）---
# 每会话每日预算（USD）
GATEWAY_SESSION_BUDGET_USD=0
# 全局每日预算（USD）
GATEWAY_DAILY_BUDGET_USD=0
# 超预算处置：downgrade（降档）| reject（拒绝 429）
GATEWAY_BUDGET_ACTION=downgrade

# --- V2: 反馈闭环 ---
# 接入工具执行结果后，失败会话的下一批请求自动升档
GATEWAY_ESCALATE_ON_FAILURE=true
# 回看最近多少条工具反馈
GATEWAY_FAILURE_WINDOW=20

# --- V2: /health 上游探测 ---
GATEWAY_HEALTH_PROBE_TIMEOUT=2.0
