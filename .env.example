# Required: DeepSeek API key. Keep this file local after copying to .env.
DEEPSEEK_API_KEY=

# Optional settings
DEEPSEEK_BASE_URL=https://api.deepseek.com
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9000
GATEWAY_DB_PATH=storage/usage.db
GATEWAY_TIMEOUT_SECONDS=300
GATEWAY_DEFAULT_MODEL=deepseek-flash

# USD per million tokens. Update these when provider pricing changes.
GATEWAY_INPUT_CACHE_HIT_PER_M=0.006
GATEWAY_INPUT_CACHE_MISS_PER_M=0.3
GATEWAY_OUTPUT_PER_M=1.2

